<?xml version="1.0" encoding="utf-8"?>
<!-- Rend le feed local MicroForge visible pour tout projet situé sous ce dossier.
     Pour les projets ailleurs sur la machine : install.ps1, ou « forge init . » dans
     le projet consommateur. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="MicroForge" value="feed" />
    <!-- Serveur d'équipe local, utilisé par les tests d'intégration (BaGet en Docker).
         NuGet refuse « push » vers une source HTTP sans autorisation explicite : un
         dépôt d'équipe réel doit être servi en HTTPS. -->
    <add key="MicroForgeTestServer" value="http://localhost:5555/v3/index.json"
         allowInsecureConnections="true" />
  </packageSources>
</configuration>
