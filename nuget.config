<?xml version="1.0" encoding="utf-8"?>
<!-- Rend le feed local MicroForge visible pour tout projet situé sous ce dossier.
     Pour les projets ailleurs sur la machine : setup.ps1 -Global, ou copier ce fichier
     à la racine du projet consommateur en adaptant le chemin du feed. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="MicroForge" value="feed" />
  </packageSources>
</configuration>
