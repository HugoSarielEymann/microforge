<?xml version="1.0" encoding="utf-8"?>
<!-- Rend le feed local MicroForge visible pour tout projet situé sous ce dossier.
     Pour les projets ailleurs sur la machine : install.ps1, ou « forge init . » dans
     le projet consommateur.

     Un dépôt d'équipe ne se déclare PAS ici : une source injoignable fait échouer
     toute restauration, y compris hors ligne. Voir SERVER.md. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="MicroForge" value="feed" />
  </packageSources>
</configuration>
