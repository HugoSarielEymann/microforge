<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SnippetForge</RootNamespace>
    <AssemblyName>SnippetForge</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Distribution en outil .NET global : « dotnet tool install -g MicroForge.Cli »
       remplace le lanceur PowerShell, la manipulation du PATH et le shim .cmd.
       Fonctionne à l'identique sur Windows, macOS et Linux. -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>forge</ToolCommandName>
    <PackageId>MicroForge.Cli</PackageId>
    <Version>0.4.1</Version>
    <Authors>Hugo Eymann</Authors>
    <Description>Forge de micropackages MicroForge : recherche, validation, publication et maintenance d'une bibliothèque de code générique réutilisable.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright 2026 Hugo Eymann</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../LICENSE" Pack="true" PackagePath="\" />
    <None Include="../../NOTICE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lecture des assemblies publiées en mode métadonnées : le contrat public est
         extrait sans jamais exécuter le code d'un package. -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SnippetForge.Tests" />
  </ItemGroup>

</Project>
