<Project Sdk="Microsoft.NET.Sdk">

  <!-- Auteur, licence, symboles de débogage et attribution sont hérités de
       packages/Directory.Build.props : ne pas les redéclarer ici. -->
  <PropertyGroup>
    <PackageId>Micro.Text.FileNameSanitize</PackageId>
    <Version>1.0.0</Version>
    <Description>Transforme un titre saisi par un humain en nom de fichier valide sous Windows : caractères interdits retirés ou remplacés, noms réservés (CON, NUL…) évités, points finaux ôtés, longueur bornée sans couper un caractère.</Description>
    <PackageTags>text;filename;sanitize;path;windows;title;generic</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>