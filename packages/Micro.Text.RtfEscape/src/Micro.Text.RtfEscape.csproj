<Project Sdk="Microsoft.NET.Sdk">

  <!-- Auteur, licence, symboles de débogage et attribution sont hérités de
       packages/Directory.Build.props : ne pas les redéclarer ici. -->
  <PropertyGroup>
    <PackageId>Micro.Text.RtfEscape</PackageId>
    <Version>1.0.0</Version>
    <Description>Échappe du texte brut pour l'insérer dans un document RTF : antislash et accolades protégés, tabulations et fins de ligne converties, caractères non ASCII écrits en \uN? sur des unités UTF-16.</Description>
    <PackageTags>text;rtf;escape;encoding;richedit;unicode;generic</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>