<!--
  FICHIER IMMUABLE (RULES.md) : règles de compilation communes à TOUS les micropackages.
  Ne pas modifier, ne pas surcharger ces propriétés dans un .csproj de package.
-->
<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    Débogage : symboles ET sources embarqués dans l'assembly.

    C'est la réponse au reproche le plus fréquent fait aux bibliothèques nombreuses :
    « on ne peut pas entrer dans le code ». Avec un PDB embarqué et les sources
    incluses, F11 entre dans le micropackage comme dans du code du projet — sans
    serveur de symboles, sans SourceLink, sans connexion réseau.

    Le surcoût est négligeable ici : un micropackage fait quelques dizaines de lignes.
  -->
  <PropertyGroup>
    <DebugType>embedded</DebugType>
    <EmbedAllSources>true</EmbedAllSources>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!--
    Attribution. À défaut de marque déposée, la mention d'auteur portée par le NOTICE
    est la seule protection dont dispose l'auteur : la section 4(d) de la licence
    Apache 2.0 impose de la reproduire dans toute redistribution, y compris modifiée.
    Elle est donc centralisée ici plutôt que laissée à chaque package.
  -->
  <PropertyGroup>
    <Authors>Hugo Eymann</Authors>
    <Copyright>Copyright 2026 Hugo Eymann</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/HugoSarielEymann/microforge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/HugoSarielEymann/microforge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../NOTICE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    Analyseur de pureté (R3). Il travaille sur le modèle sémantique : un alias
    « using C = System.Console; » ne le contourne pas, contrairement à la détection
    textuelle qu'il complète. Les violations apparaissent dans l'IDE, à la frappe.

    Référence par projet ici, parce que l'analyseur vit dans ce dépôt. Une
    bibliothèque créée par « forge create » utilisera plutôt le package publié :
      <PackageReference Include="MicroForge.Analyzers" Version="…"
                        PrivateAssets="all" IncludeAssets="analyzers" />
  -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../tools/MicroForge.Analyzers/MicroForge.Analyzers.csproj')">
    <ProjectReference Include="$(MSBuildThisFileDirectory)../tools/MicroForge.Analyzers/MicroForge.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

</Project>
